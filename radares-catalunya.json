    async function actualizarBaseRadaresOficial(esManual = false) {
      if (esManual) {
        log("Consultando actualización de radares...");
        locucion("Buscando actualización de radares...");
      }

      let radaresNuevos = null;

      try {
        // Forzamos la descarga directa ignorando la caché del navegador
        const res = await fetch("./radares-catalunya.json?v=" + Date.now(), { 
          cache: "no-store",
          headers: { "Accept": "application/json" }
        });
        
        if (res.ok) {
          const datos = await res.json();
          if (Array.isArray(datos) && datos.length > 0) {
            radaresNuevos = datos;
          }
        } else {
          log(`Aviso: Archivo remoto respondió código ${res.status}`);
        }
      } catch (e) {
        log("Fallo de red al conectar con el servidor.");
      }

      if (radaresNuevos) {
        baseRadares = radaresNuevos;
        localStorage.setItem("radares_catalunya_cache", JSON.stringify(radaresNuevos));
        actualizarEstadoContador();
        log(`BD: Actualizada (${radaresNuevos.length} radares guardados).`);
        if (esManual) locucion(`Base de datos actualizada con ${radaresNuevos.length} puntos`);
        return;
      }

      // Si no encuentra el archivo o no hay internet, cargamos la memoria local
      const cacheMovil = localStorage.getItem("radares_catalunya_cache");
      if (cacheMovil) {
        try {
          const guardados = JSON.parse(cacheMovil);
          if (Array.isArray(guardados) && guardados.length > 0) {
            baseRadares = guardados;
            actualizarEstadoContador();
            if (esManual) locucion(`Cargados ${guardados.length} radares de la memoria`);
            return;
          }
        } catch (e) {}
      }

      // En último recurso, usa los radares integrados por defecto
      baseRadares = [...baseRadaresDefault];
      actualizarEstadoContador();
      if (esManual) locucion(`Base activa con ${baseRadares.length} radares`);
    }
